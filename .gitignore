# Environment files (secrets)
.env*

# Override global gitignore /Packages rule (matches packages/ on macOS)
!/packages/
packages/*/node_modules/
packages/*/dist/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
# Xcode shared Swift Package Manager workspace data (regenerated by Xcode)
ios/Runner.xcworkspace/xcshareddata/swiftpm/
migrate_working_dir/
test_hive_*/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/app/.cxx

# Externally released plugin build outputs
assets/plugins/dye2.reaplugin/
assets/plugins/shot-upload.reaplugin/
assets/plugins/dcamp.reaplugin/

# Skin bundling
.skin_cache/
assets/bundled_skins/

# Ruby / fastlane (bundler vendored install)
.bundle/
vendor/bundle/
pubspec_overrides.yaml

# Local-only agent skill: google-analytics-cli (kept out of the repo)
/skills-lock.json
/.agents/skills/google-analytics-cli/
/.claude/skills/google-analytics-cli

# Brainstorming visual companion
.superpowers/
# Added by code-review-graph
.code-review-graph/
